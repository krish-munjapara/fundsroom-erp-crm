# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Replace with your actual PostgreSQL connection string
# Example for Neon: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://your_username:your_password@your_host:5432/your_database?sslmode=require

# JWT Configuration
# REQUIRED in production — server will fail to start without this when NODE_ENV=production
JWT_SECRET=your_jwt_secret_here_change_this_in_production

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
